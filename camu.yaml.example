server:
  address: ":8080"
  internal_address: ":8081"
  replication_address: ":8082"
  instance_id: ""
  # "stream" is the default; use "query" with camu.query.yaml.example for
  # read-only SQL nodes. Query nodes do not need internal_address or kafka_port.
  mode: "stream"
  # Optional bearer token required by /v1/sql when SQL is enabled.
  auth_token: ""
storage:
  bucket: "camu-data"
  region: "us-east-1"
  endpoint: ""
  credentials:
    access_key: ""
    secret_key: ""
segments:
  max_size: 8388608
  max_age: "5s"
  compression: "none"
  record_batch_target_size: 16384
  index_interval_bytes: 4096
cache:
  directory: "/var/lib/camu/cache"
  max_size: 10737418240
sql:
  enabled: false
  cache_directory: "/var/lib/camu/sql-cache"
  duckdb_temp_directory: "/var/lib/camu/sql-tmp"
  cache_max_size: 5368709120
  duckdb_memory_limit: "1GB"
  max_concurrency: 4
  query_timeout: "30s"
  max_scan_files: 4096
coordination:
  lease_ttl: "30s"
  rebalance_delay: "5s"
  heartbeat_interval: "10s"
  maintenance_max_concurrency: 4
  isr_expansion_threshold: 1000
  replication_timeout: "30s"
  # How long a follower waits for the leader to respond to a fetch before
  # counting it toward leader-down detection. A healthy leader responds within
  # its ~500ms long-poll window, so this can be far shorter than
  # replication_timeout (which bounds produce purgatory waits).
  replication_read_timeout: "10s"
  # How often rf=1 produce re-verifies partition ownership against the
  # assignment store before acknowledging. A shorter interval narrows the
  # window in which a fenced leader can ack writes it will later lose.
  fence_interval: "2s"
diskless:
  linger_ms: 250
  max_batch_bytes: 8388608
  # "memory" (default, single-node dev), "s3" (offsets and segment catalog
  # backed by the same object store; no DynamoDB required), or "dynamodb".
  metastore: "memory"
maintenance:
  parquet_export:
    # Requires unclean_leader_election: false on every topic.
    enabled: false
    max_records: 16384
    max_duration: "30s"
    temp_directory: "/var/lib/camu/parquet-tmp"
