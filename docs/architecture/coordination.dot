digraph coordination {
    rankdir=TB;
    fontname="Helvetica";
    node [fontname="Helvetica", fontsize=11, shape=box, style="rounded,filled", fillcolor="#f5f5f5"];
    edge [fontname="Helvetica", fontsize=9];
    compound=true;
    newrank=true;

    // Title
    labelloc="t";
    label="Camu Coordination Architecture\n(S3-based, no consensus protocol)";
    fontsize=16;

    // ---- S3 Coordination Objects ----
    subgraph cluster_s3 {
        label="S3 Coordination Store\n(_coordination/ prefix)";
        style="filled,rounded";
        fillcolor="#e8f4fd";
        color="#2196F3";

        leader_json [label="leader.json\n{instance_id, expires_at}\nCluster coordinator lease\nCAS via ETag", shape=note, fillcolor="#bbdefb"];
        assignments_json [label="assignments/{topic}.json\n{partitions: {pid: {leader,\nepoch, replicas}}, version}\nCAS via ETag", shape=note, fillcolor="#bbdefb"];
        isr_json [label="isr/{topic}/{pid}.json\n{isr: [...], leader, epoch,\nhigh_watermark}\nUnconditional PUT (!)", shape=note, fillcolor="#ffcdd2"];
        epochs_json [label="epochs/{topic}/{pid}.json\n[{epoch, start_offset}, ...]\nUnconditional PUT", shape=note, fillcolor="#bbdefb"];
        instances_json [label="instances/{id}.json\n{address, internal_addr,\nheartbeat_at}\nUnconditional PUT", shape=note, fillcolor="#bbdefb"];
    }

    // ---- Node Architecture ----
    subgraph cluster_node {
        label="Camu Node";
        style="filled,rounded";
        fillcolor="#f1f8e9";
        color="#4CAF50";

        subgraph cluster_coordination_loop {
            label="renewLeases (every heartbeat_interval=10s)";
            style="filled,rounded";
            fillcolor="#dcedc8";
            color="#8BC34A";

            renew_lease [label="1. Renew cluster\nleader lease\n(CAS on leader.json)"];
            heartbeat [label="2. Write instance\nheartbeat\n(instances/{id}.json)"];
            publish [label="3. Publish assignments\n(if cluster leader)\n(CAS on assignments/)"];
            apply [label="4. Apply assignments\nlocally\n(init leader/follower)"];
            check_isr [label="5. Check ISR lag\n(remove stale followers)\n(write isr/ if changed)"];
        }

        subgraph cluster_partition_state {
            label="partitionState (per partition)";
            style="filled,rounded";
            fillcolor="#fff9c4";
            color="#FFC107";

            ps_fields [label="ps.mu RWMutex\nps.isLeader bool\nps.epoch uint64\nps.nextOffset uint64\nps.flushedOffset uint64\nps.epochHistory\nps.replicaState\nps.replicaConns\nps.fetchCancel / fetchDone\nps.wal *WAL\nps.index *PartitionIndex", shape=record, fillcolor="#fff9c4"];
        }

        subgraph cluster_produce {
            label="Produce Path";
            style="filled,rounded";
            fillcolor="#e8eaf6";
            color="#3F51B5";

            produce_verify [label="verifyProduceLeadership\n(local cache check!\nNOT S3 - stale for\nup to heartbeat_interval)", fillcolor="#ffcdd2"];
            produce_append [label="appendBatchToPS\n(ps.mu.Lock)\nassign offsets\nWAL write\nnotify replicas"];
            produce_purgatory [label="Purgatory.Wait\n(block until HW\nadvances past offset)"];
        }

        subgraph cluster_replication {
            label="Replication";
            style="filled,rounded";
            fillcolor="#fce4ec";
            color="#E91E63";

            leader_handler [label="handleReplicaFetch\n(HTTP handler)\n1. Check divergence\n2. Implicit ack\n3. Read WAL frames\n4. Long-poll 500ms\n5. Return raw batches"];
            follower_fetcher [label="FollowerFetcher.Run\n(HTTP client loop)\n1. Fetch from leader\n2. Append to local WAL\n3. Track errors\n4. onLeaderDown after\n   >10 consecutive errors\n   (~26s detection)"];
            replica_state [label="ReplicaState\n- isrSet map\n- followerOffsets\n- highWatermark\n- purgatory\n- WaitForData channel"];
        }

        subgraph cluster_failover {
            label="Failover Path";
            style="filled,rounded";
            fillcolor="#fff3e0";
            color="#FF9800";

            on_leader_down [label="onLeaderDown\ncallback"];
            attempt [label="attemptPartitionLeadership\n1. Read ISR (S3)\n2. Check ISR membership\n3. Read assignments (S3)\n4. CAS write new epoch\n5. Cancel fetch loop\n6. Refresh index (S3)\n7. Replay WAL\n8. Set HW = max(walEnd, indexNext)\n   BUG: missing isrState.HW\n9. Write epoch history\n10. Write ISR=[self]\n11. Recover idempotency\n12. Recovery flush if needed"];
        }

        subgraph cluster_flush {
            label="Flush Path (async)";
            style="filled,rounded";
            fillcolor="#f3e5f5";
            color="#9C27B0";

            flush_check [label="onFlush\n1. Lease check\n   (verifyOwnershipFromS3)\n   BUG: not atomic with upload"];
            flush_build [label="2. Read WAL chunk\n3. Build segment\n4. Upload segment to S3\n5. Upload index to S3\n6. Update state.json\n   BUG: no CAS on state.json"];
        }
    }

    // ---- Timing Constants ----
    subgraph cluster_timing {
        label="Timing Configuration";
        style="filled,rounded";
        fillcolor="#efebe9";
        color="#795548";

        timing [label="lease_ttl = 30s\nheartbeat_interval = 10s\ninstance_ttl = 90s (3x lease)\nreplication_timeout = 30s\nisr_lag_timeout = 30s (hardcoded)\nisr_expansion_threshold = 1000 msgs\nfetcher_max_errors = 11\nfetcher_max_backoff = 5s\nlong_poll_wait = 500ms", shape=plaintext];
    }

    // ---- Edges: Coordination Loop ----
    renew_lease -> heartbeat -> publish -> apply -> check_isr;

    // ---- Edges: Apply assignments ----
    apply -> ps_fields [label="initPartitionAsLeader\nor initPartitionAsFollower", style=dashed];

    // ---- Edges: Produce ----
    produce_verify -> produce_append [label="if owned"];
    produce_append -> produce_purgatory [label="if RF>1"];
    produce_append -> replica_state [label="SetLeaderOffset\nNotifyNewData"];

    // ---- Edges: Replication ----
    follower_fetcher -> leader_handler [label="HTTP GET\n/v1/internal/replicate/\n{topic}/{pid}?from_offset=N", style=bold, color="#E91E63"];
    leader_handler -> replica_state [label="UpdateFollower\n(implicit ack)"];
    replica_state -> produce_purgatory [label="advanceHW\nPurgatory.Complete", style=dashed, color="#4CAF50"];

    // ---- Edges: Failover ----
    follower_fetcher -> on_leader_down [label=">10 errors\n(~26s)", color="#FF9800", style=bold];
    on_leader_down -> attempt;
    attempt -> assignments_json [label="CAS write\nnew epoch", color="#FF9800"];
    attempt -> isr_json [label="Write ISR=[self]\n(unconditional!)", color="#FF9800"];
    attempt -> epochs_json [label="Write epoch\nhistory", color="#FF9800"];

    // ---- Edges: Flush ----
    flush_check -> flush_build [label="if still owner"];

    // ---- Edges: S3 reads ----
    check_isr -> isr_json [label="write on\nISR shrink only\nBUG: expansion\nnot persisted", color="red", style=dashed];
    publish -> assignments_json [label="CAS write", color="#2196F3"];
    renew_lease -> leader_json [label="CAS renew", color="#2196F3"];
    heartbeat -> instances_json [label="unconditional PUT", color="#2196F3"];

    // ---- Known Bugs ----
    subgraph cluster_bugs {
        label="Known Bugs (verified)";
        style="filled,rounded";
        fillcolor="#ffebee";
        color="#f44336";

        bugs [label=<
<table border="0" cellborder="0" cellpadding="2">
<tr><td align="left"><b>Critical:</b></td></tr>
<tr><td align="left">1. checkISRLag: reads ps.isLeader/replicaState without ps.mu (data race)</td></tr>
<tr><td align="left">2. attemptPartitionLeadership: reads ps.fetchCancel without ps.mu (data race)</td></tr>
<tr><td align="left"><b>High:</b></td></tr>
<tr><td align="left">3. attemptPartitionLeadership: HW = max(walEnd, indexNext) misses isrState.HW</td></tr>
<tr><td align="left">4. ISR expansion (follower joins) never persisted to S3</td></tr>
<tr><td align="left">5. TOCTOU in initPartitionAsLeader: RLock check then proceeds unlocked</td></tr>
<tr><td align="left">6. Phantom leader: produce fencing is local-cache, up to 10s stale</td></tr>
<tr><td align="left"><b>Medium:</b></td></tr>
<tr><td align="left">7. state.json flush without CAS (stale leader can overwrite)</td></tr>
<tr><td align="left">8. ISR writes use unconditional PUT (no CAS guard)</td></tr>
<tr><td align="left">9. Epoch history StartOffset uses walEnd instead of recoveredHW</td></tr>
</table>
        >, shape=plaintext];
    }
}
